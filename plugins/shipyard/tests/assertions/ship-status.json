[
  {
    "name": "has_diagnose_subcommand",
    "type": "contains",
    "pattern": "shipyard-context diagnose"
  },
  {
    "name": "has_diagnose_section",
    "type": "contains",
    "pattern": "diagnose section|/ship-status diagnose"
  },
  {
    "name": "has_dashboard",
    "type": "contains",
    "pattern": "[Dd]ashboard|[Pp]rogress|[Oo]verview"
  },
  {
    "name": "has_schema_validation",
    "type": "contains",
    "pattern": "Frontmatter Schema|frontmatter"
  },
  {
    "name": "has_auto_fix",
    "type": "contains",
    "pattern": "Auto-fix|auto-fix|silently"
  },
  {
    "name": "has_backlog_check",
    "type": "contains",
    "pattern": "Backlog Consistency"
  },
  {
    "name": "has_sprint_check",
    "type": "contains",
    "pattern": "Sprint Consistency"
  },
  {
    "name": "has_next_action",
    "type": "contains",
    "pattern": "NEXT ACTION"
  },
  {
    "name": "no_ship_reconcile_ref",
    "type": "not_contains",
    "pattern": "/ship-reconcile"
  },
  {
    "name": "has_frontmatter_name",
    "type": "frontmatter_field",
    "field": "name",
    "value": "ship-status"
  },
  {
    "name": "has_execution_lock_handling",
    "type": "contains",
    "pattern": "\\.active-execution\\.json"
  },
  {
    "name": "has_stale_lock_cleanup",
    "type": "contains",
    "pattern": "stale|2.*hour|escape hatch"
  },
  {
    "name": "detects_paused_cursor",
    "type": "contains",
    "pattern": "status: paused",
    "why": "v2.9.0: HANDOFF.md retired — a paused pipeline is a cursor with status: paused; ship-status surfaces it as RESUME"
  },
  {
    "name": "has_id_reference_integrity",
    "type": "contains",
    "pattern": "ID.*Reference|[Dd]uplicate.*ID|broken.*dep"
  },
  {
    "name": "has_git_alignment_check",
    "type": "contains",
    "pattern": "Git Alignment"
  },
  {
    "name": "has_file_hygiene",
    "type": "contains",
    "pattern": "File Hygiene"
  },
  {
    "name": "has_file_size_health",
    "type": "contains",
    "pattern": "File Size|rollover"
  },
  {
    "name": "has_reconcile_log",
    "type": "contains",
    "pattern": "reconcile-log"
  },
  {
    "name": "has_health_subcommand",
    "type": "contains",
    "pattern": "ship-status health|throughput"
  },
  {
    "name": "has_sprint_subcommand",
    "type": "contains",
    "pattern": "ship-status sprint|per-wave"
  },
  {
    "name": "uses_ask_user_question",
    "type": "contains",
    "pattern": "AskUserQuestion"
  },
  {
    "name": "uses_shipyard_data_path",
    "type": "contains",
    "pattern": "shipyard-data|shipyard-context"
  },
  {
    "name": "no_shell_sd_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-data"
  },
  {
    "name": "no_shell_sc_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-context"
  },
  {
    "name": "no_sd_shell_var_assignment",
    "type": "not_contains",
    "pattern": "SD=\\$\\(shipyard-data"
  },
  {
    "name": "task_status_enum_includes_needs_attention",
    "type": "contains",
    "pattern": "pending.*in-progress.*done.*blocked.*needs-attention",
    "dotall": true
  },
  {
    "name": "status_indicator_for_needs_attention",
    "type": "contains",
    "pattern": "⚠️ needs-attention|⚠ needs-attention|needs-attention.*⚠"
  },
  {
    "name": "needs_attention_distinct_from_blocked",
    "type": "contains",
    "pattern": "needs-attention.*blocked|distinct from.*blocked|tried and failed",
    "dotall": true
  },
  {
    "name": "prohibits_bash_redirect_for_state",
    "type": "contains",
    "pattern": "echo.*redirect.*Write tool|Never use.*echo.*Write tool"
  },
  {
    "name": "renders_review_cursor",
    "type": "contains",
    "pattern": "REVIEW-CURSOR\\.md"
  },
  {
    "name": "renders_execute_cursor",
    "type": "contains",
    "pattern": "EXECUTE-CURSOR\\.md"
  },
  {
    "name": "renders_pipeline_stage",
    "type": "contains",
    "pattern": "[Pp]ipeline [Ss]tage|[Cc]urrent [Ss]tage|[Cc]ursor"
  },
  {
    "name": "renders_terminal_state",
    "type": "contains",
    "pattern": "terminal:|[Tt]erminal|pipeline_terminal"
  },
  {
    "name": "renders_stuck_warning",
    "type": "contains",
    "pattern": "pipeline_stuck|stuck_counter|stuck"
  },
  {
    "name": "no_backlog_hand_edit_instruction",
    "type": "not_contains",
    "pattern": "archive completed items by Edit",
    "why": "v3.6.0 wave 2 binding resolution: ship-status stays read-only — Check 7 surfaces the recommendation instead of hand-Editing BACKLOG.md."
  },
  {
    "name": "backlog_size_check_points_at_ship_backlog_archive",
    "type": "contains",
    "pattern": "/ship-backlog archive",
    "why": "v3.6.0 wave 2: Check 7's BACKLOG.md-oversize remediation now tells the user to run /ship-backlog archive rather than mutating BACKLOG.md itself."
  },
  {
    "name": "uses_lock_status",
    "type": "contains",
    "pattern": "lock status",
    "why": "v3.7.0 wave 3: File Hygiene's skill-mutex rendering reads both lock files in one call via shipyard-data lock status instead of hand-parsing JSON."
  },
  {
    "name": "uses_lock_release_force",
    "type": "contains",
    "pattern": "lock release.*--force",
    "why": "v3.7.0 wave 3: stale/user-confirmed lock clearing routes through shipyard-data lock release --force instead of a hand Write of the cleared sentinel."
  }
]
