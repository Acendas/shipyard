[
  {
    "name": "has_session_id_field",
    "type": "contains",
    "pattern": "session_id"
  },
  {
    "name": "uses_shipyard_data_lock_cli",
    "type": "contains",
    "pattern": "shipyard-data lock"
  },
  {
    "name": "documents_depth_field",
    "type": "contains",
    "pattern": "depth"
  },
  {
    "name": "documents_session_unverified_asymmetry",
    "type": "contains",
    "pattern": "session-unverified|session_unverified"
  },
  {
    "name": "references_two_lock_files",
    "type": "contains",
    "pattern": "active-session.json"
  },
  {
    "name": "references_two_hour_stale",
    "type": "contains",
    "pattern": "2 hours|2h|>2h"
  },
  {
    "name": "no_compaction_count",
    "type": "not_contains",
    "pattern": "compaction_count:\\s*0|\"compaction_count\""
  },
  {
    "name": "no_old_procedure_headers",
    "type": "not_contains",
    "pattern": "## Acquire Procedure|## Release Procedure|## Re-Entry Within the Same Session|## Stale Lock Recovery"
  },
  {
    "name": "no_step_by_step_write_instructions",
    "type": "not_contains",
    "pattern": "Use the .Write. tool to overwrite the lock file|Use .Write. to overwrite the lock file"
  },
  {
    "name": "no_registered_shipyard_agent",
    "type": "not_contains",
    "pattern": "subagent_type: *shipyard:shipyard-"
  },
  {
    "name": "no_dead_reference_links",
    "type": "not_contains",
    "pattern": "references/(refactor-loop|context-pressure|live-capture|test-delegation|tdd-cycle|operational-tasks|research-tasks)\\.md"
  }
]
