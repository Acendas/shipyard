  {
    "name": "has_lsp_first_principle",
    "type": "contains",
    "pattern": "LSP-first|LSP.*before.*Grep"
  },
  {
    "name": "no_shell_sd_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-data"
  },
  {
    "name": "no_shell_sc_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-context"
  },
  {
    "name": "no_sd_shell_var_assignment",
    "type": "not_contains",
    "pattern": "SD=\\$\\(shipyard-data"
  },
  {
    "name": "has_planning_mutex_check",
    "type": "contains",
    "pattern": "Planning-session mutex check|Planning session active"
  },
  {
    "name": "planning_check_uses_lock_check_cli",
    "type": "contains",
    "pattern": "shipyard-data lock check planning"
  },
  {
    "name": "debug_runs_through_logcap",
    "type": "contains",
    "pattern": "shipyard-logcap run"
  },
  {
    "name": "debug_iter_capture_naming",
    "type": "contains",
    "pattern": "<debug-slug>-iter<N>|debug-slug>-iter"
  },
  {
    "name": "debug_verify_runs_captured",
    "type": "contains",
    "pattern": "<debug-slug>-verify-repro|verify-repro|verify-tests"
  },
  {
    "name": "debug_allowed_tools_has_logcap",
    "type": "contains",
    "pattern": "Bash\\(shipyard-logcap:"
  },
  {
    "name": "debug_context_is_bundled",
    "type": "contains",
    "pattern": "shipyard-context debug-session"
  },
  {
    "name": "debug_evidence_references_captures",
    "type": "contains",
    "pattern": "capture: <debug-slug|capture name"
  },
  {
    "name": "prohibits_bash_redirect_for_state",
    "type": "contains",
    "pattern": "echo.*redirect.*Write tool|Never use.*echo.*Write tool"
  },
  {
    "name": "uses_lock_check",
    "type": "contains",
    "pattern": "lock check",
    "why": "v3.7.0 wave 3: both the planning and execution mutex checks are read-only via shipyard-data lock check \u2014 ship-debug never acquires either lock, it only verifies neither is held by someone else."
  },
  {
    "name": "no_hand_write_lock_file",
    "type": "not_contains",
    "pattern": "use the Write tool.*active-(session|execution)|Use Write.*active-(session|execution)",
    "why": "v3.7.0 wave 3: skill-mutex lock files are CLI-owned \u2014 no skill body hand-Writes them anymore."
  },
  {
    "name": "fix_phase_acquires_execution_lock",
    "type": "contains",
    "pattern": "lock acquire execution --skill ship-debug"
  },
  {
    "name": "fix_phase_releases_execution_lock",
    "type": "contains",
    "pattern": "lock release execution --skill ship-debug"
  },
  {
    "name": "render_provenance_negation",
    "type": "contains",
    "pattern": "does not count as rendered",
    "why": "v3.11.0 context-conflation fix: the render-before-ask rule must state the negative \u2014 Read results, subagent returns, dossier files, and SendMessage payloads are not 'shown to the user'. Anchors the same phrase check_render_before_ask requires."
  },
  {
    "name": "quiet_by_default",
    "type": "contains",
    "pattern": "Quiet by default"
  }
]
