[
  {
    "name": "has_frontmatter_name",
    "type": "frontmatter_field",
    "field": "name",
    "value": "ship-help"
  },
  {
    "name": "has_question_mode",
    "type": "contains",
    "pattern": "question|Mode 1"
  },
  {
    "name": "has_how_to_mode",
    "type": "contains",
    "pattern": "how.to|Mode 2|walk.*through"
  },
  {
    "name": "has_action_mode",
    "type": "contains",
    "pattern": "action|Mode 3|do it"
  },
  {
    "name": "has_lost_mode",
    "type": "contains",
    "pattern": "lost|Mode 4|suggest.*next"
  },
  {
    "name": "has_workflow_overview",
    "type": "contains",
    "pattern": "discuss.*sprint.*execute.*review",
    "dotall": true
  },
  {
    "name": "has_init_guard",
    "type": "contains",
    "pattern": "SHIPYARD_ONBOARDING_REQUIRED|onboarding"
  },
  {
    "name": "has_version_display",
    "type": "contains",
    "pattern": "version|plugin\\.json"
  },
  {
    "name": "help_context_is_bundled",
    "type": "contains",
    "pattern": "shipyard-context help-context"
  },
  {
    "name": "uses_shipyard_data_path",
    "type": "contains",
    "pattern": "shipyard-data|shipyard-context"
  },
  {
    "name": "has_next_up_routing",
    "type": "contains",
    "pattern": "ship-discuss|ship-sprint|ship-status"
  },
  {
    "name": "no_shell_sd_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-data"
  },
  {
    "name": "no_shell_sc_substitution",
    "type": "not_contains",
    "pattern": "\\$\\(shipyard-context"
  },
  {
    "name": "no_sd_shell_var_assignment",
    "type": "not_contains",
    "pattern": "SD=\\$\\(shipyard-data"
  },
  {
    "name": "diagram_help_is_significance_based",
    "type": "contains",
    "pattern": "significance, not participation"
  },
  {
    "name": "diagram_help_lists_full_set",
    "type": "contains",
    "pattern": "ER / data-model"
  },
  {
    "name": "diagram_help_no_stale_3plus_components",
    "type": "not_contains",
    "pattern": "Involves \\*\\*3\\+ components\\*\\*"
  },
  {
    "name": "diagram_help_check16_type_aware",
    "type": "contains",
    "pattern": "type-aware"
  },
  {
    "name": "mentions_think_override",
    "type": "contains",
    "pattern": "--think"
  },
  {
    "name": "mentions_config_set_model",
    "type": "contains",
    "pattern": "config set-model"
  },
  {
    "name": "model_changes_are_action_mode",
    "type": "contains",
    "pattern": "Natural-language model changes are Action mode|set build model to opus"
  },
  {
    "name": "mode3_routes_state_through_cli",
    "type": "contains",
    "pattern": "shipyard-data story set-status|shipyard-data backlog|CLI-owned"
  },
  {
    "name": "no_hand_edit_cli_owned_state",
    "type": "contains",
    "pattern": "NEVER hand-Edit|never a hand-edit|auto-approve hook denies"
  },
  {
    "name": "has_shipyard_data_scope",
    "type": "contains",
    "pattern": "Bash\\(shipyard-data"
  },
  {
    "name": "render_provenance_negation",
    "type": "contains",
    "pattern": "does not count as rendered",
    "why": "v3.11.0 context-conflation fix: the render-before-ask rule must state the negative \u2014 Read results, subagent returns, dossier files, and SendMessage payloads are not 'shown to the user'. Anchors the same phrase check_render_before_ask requires. S016/P062: canonical text now lives in CANONICAL_STARTUP_RULES (bin/shipyard-context.mjs).",
    "target": "plugin:bin/shipyard-context.mjs"
  },
  {
    "name": "documents_effort_setter",
    "type": "contains",
    "pattern": "config set-effort",
    "why": "Spawned-agent effort tiers must be user-configurable through the CLI, not hand-edited in config frontmatter."
  },
  {
    "name": "nl_model_change_names_light_tier",
    "type": "contains",
    "pattern": "resolve the tier \\(`build`, `think`, `orchestrate`, or `light`\\)",
    "why": "S004 AC-1: the natural-language model-change sentence must offer the `light` tier alongside build/think/orchestrate, matching the set-model syntax string above it."
  },
  {
    "name": "render_before_ask_short_reminder_present",
    "type": "contains",
    "pattern": "Render before asking",
    "why": "S016/P062: the command keeps only the short reminder; the full doctrine is printed at startup (CANONICAL_STARTUP_RULES)."
  },
  {
    "name": "tutorial_how_to",
    "type": "contains",
    "pattern": "/ship-quick --tutorial",
    "why": "/ship-help tutorial repeats the offer at any time"
  },
  {
    "name": "tutorial_sandbox_how_to",
    "type": "contains",
    "pattern": "/ship-quick --tutorial --sandbox",
    "why": "the sandbox is the alternative for someone who will not touch real code on day one"
  },
  {
    "name": "tutorial_record_is_cli_owned",
    "type": "contains",
    "pattern": "onboarding\\.json[^\\n]*CLI-owned",
    "why": "the record is read, never edited, by the session"
  }
]
